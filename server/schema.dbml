table class_curricula {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  class_id uuid [not null]
  courses jsonb [not null]
  total_points integer [not null, default: 0]
  is_valid integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table project_classes {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  project_id uuid [not null]
  program_id uuid [not null]
  class_code text [not null]
  start_year integer [not null]
  graduation_year integer [not null]
  is_active integer [not null, default: 1]
  created_at timestamp [not null, default: `now()`]
}

table project_programs {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  project_id uuid [not null]
  program_code text [not null]
  program_name text [not null]
  orientation_code text [not null]
  orientation_name text [not null]
  created_at timestamp [not null, default: `now()`]
}

table projects {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  name text [not null]
  description text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table rooms {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  project_id uuid [not null]
  room_number text [not null]
  room_type text
  capacity integer
  notes text
  created_at timestamp [not null, default: `now()`]
}

table teachers {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  project_id uuid [not null]
  name text [not null]
  email text
  subject text
  notes text
  created_at timestamp [not null, default: `now()`]
}

table users {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email text [not null, unique]
  name text [not null]
  password_hash text [not null]
  created_at timestamp [not null, default: `now()`]
}

ref: class_curricula.class_id > project_classes.id

ref: project_classes.project_id > projects.id

ref: project_classes.program_id > project_programs.id

ref: project_programs.project_id > projects.id

ref: projects.user_id > users.id

ref: rooms.project_id > projects.id

ref: teachers.project_id > projects.id